# ============================================================
# Eco-Loop Building Agents — Environment Configuration
# Copy this file to .env (both at repo root and in backend/) and
# fill in the placeholders marked "<<< SET ME >>>".
# See README.md -> "Manual Steps Required" for a full walkthrough.
# ============================================================

# ------------------------------------------------------------
# Backend
# ------------------------------------------------------------
APP_NAME=Eco-Loop Building Agents
APP_VERSION=0.2.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------
# Database (SQLite — no setup needed, file is created automatically)
# ------------------------------------------------------------
DATABASE_URL=sqlite:///./ecoloop.db

# ------------------------------------------------------------
# EnergyPlus (Part 1 / Part 4)
# Leave USE_MOCK_ENERGYPLUS=true to run with zero setup.
# To use the real EnergyPlus engine, install it locally, then set
# ALL FOUR values below and flip USE_MOCK_ENERGYPLUS to false.
# ------------------------------------------------------------
# Path to your EnergyPlus install directory (folder containing the
# `energyplus` / `energyplus.exe` executable).
#   Windows example: C:/EnergyPlusV24-1-0
#   Linux example:   /usr/local/EnergyPlus-24-1-0
#   macOS example:   /Applications/EnergyPlus-24-1-0
ENERGYPLUS_DIR=E:/EnergyPlusV26-1-0

# Absolute path to the .idf building model you want to simulate.
#   Windows example: C:/EnergyPlusV24-1-0/ExampleFiles/RefBldgSmallOfficeNew2004_Chicago.idf
ENERGYPLUS_IDF=E:/EnergyPlusV26-1-0/ExampleFiles/RefBldgSmallOfficeNew2004_Chicago.idf

# Absolute path to the .epw weather file for your building's location.
#   Windows example: C:/EnergyPlusV24-1-0/WeatherData/USA_IL_Chicago-OHare.Intl.AP.725300_TMY3.epw
ENERGYPLUS_EPW=E:/EnergyPlusV26-1-0/USA_IL_Chicago-Midway.AP.725340_TMY.epw

# Folder (relative to backend/, or absolute) where each simulation run's
# output files are written. Created automatically if it doesn't exist.
OUTPUT_DIRECTORY=energyplus/output

ENERGYPLUS_TIMEOUT_SECONDS=600

# true = MockEnergyPlusService (default, zero setup, deterministic demo data)
# false = RealEnergyPlusService (requires the 4 values above)
# NOTE: even if set to false, the app auto-falls-back to the mock with a
# logged warning if the real install/files can't be found, so it never
# fails to start.
USE_MOCK_ENERGYPLUS=false

# ------------------------------------------------------------
# Ollama / LLM (Part 3 support)
# Leave USE_MOCK_LLM=true to run with zero setup.
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=60
# true = MockLLMService. false = RealLLMService (requires Ollama running
# and `ollama pull qwen3:8b`). Same auto-fallback pattern as EnergyPlus.
USE_MOCK_LLM=true

# ------------------------------------------------------------
# FastMCP server (Part 2)
# Only used when running `python -m app.mcp.server` standalone
# (e.g. Claude Desktop, `mcp inspect`, or the SSE transport below).
# The backend's own REST API and LangGraph agents do NOT need this
# server running — they call the same tool functions in-process.
# ------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8765
# stdio (default, for local MCP clients) or sse (network-accessible)
MCP_TRANSPORT=stdio

# ------------------------------------------------------------
# Optimization cycle / LangGraph
# ------------------------------------------------------------
CYCLE_INTERVAL_MINUTES=15
MAX_RETRIES=3
MAX_ACTIONS_PER_CYCLE=5
COMFORT_PRIORITY=0.6
MIN_SAVINGS_THRESHOLD=0.01

# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/ecoloop.log
